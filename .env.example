# Copy this file to .env and fill in the values. Never commit .env.

# Meta Model API key (primary verdict engine: Muse Spark + Muse Voice Transcribe).
# This is ONE key from the Meta developer console, used to authenticate calls
# to https://api.meta.ai/v1 (chat completions, vision, and speech-to-text).
# Fill only ONE of the two names below; they are aliases for the same key.
# Official Meta examples name it MODEL_API_KEY; this project also accepts META_API_KEY.
META_API_KEY=
MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Web search provider (optional). Supported: tavily, brave, serper.
# Without a key, the app falls back to a keyless search and then to honest refusals.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Database (Neon Postgres). Set this to make history, verdicts, and supplier
# memory durable. On Vercel, the Neon integration injects it automatically.
# Without it, the app falls back to ephemeral local JSON storage.
DATABASE_URL=

# Optional fallback inference (Fireworks) and background workers (Modal).
# Leave empty for the local MVP; the app runs without them.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
